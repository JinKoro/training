{
  "name": "training",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "npm run build && node scripts/deploy-pages.mjs",
    "test:unit": "vitest run --config tests/unit/vitest.config.ts",
    "test:api": "vitest run --config tests/api/vitest.config.ts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.6",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
